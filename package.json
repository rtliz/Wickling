{
  "name": "wickling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && rolldown scripts/check.ts -o node_modules/.cache/check/check.mjs -p node -f esm --log-level warn && node node_modules/.cache/check/check.mjs",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.0.0",
    "rolldown": "~1.2.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.18.2",
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "cordova-plugin-purchase": "^13.20.0",
    "firebase": "^13.1.0"
  }
}
