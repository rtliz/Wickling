rules_version = '2';
// Wickling ยังไม่ใช้ Firestore (เล่นออฟไลน์ทั้งหมด) · ปิดทุกอย่างเป็นค่าเริ่มต้นตาม .claude/rules/anti-hack.md
// เพิ่ม collection เมื่อไร: match แยก ตรวจ uid เจ้าของ, keys().hasOnly, ชนิด/ขนาด, updatedAt == request.time
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
